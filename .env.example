# Copy this file to `.env` (same folder) and fill in real values there.
# `.env` is in .gitignore and will never be committed -- this example file,
# with no real secrets in it, is the one that's safe to check in.
#
# Nothing here is required. With no .env file at all, alert/welcome emails
# are written to logs/alerts_sent.log instead of actually being sent, which
# is fine for local testing.

# --- Email alerts (optional) ---
# Gmail settings shown as an example; any SMTP provider works the same way.
# Gmail requires an App Password, not your normal login password --
# generate one at https://myaccount.google.com/apppasswords (needs
# 2-Step Verification turned on first).
WARN_SMTP_HOST=smtp.gmail.com
WARN_SMTP_PORT=587
WARN_SMTP_USER=you@gmail.com
WARN_SMTP_PASS=your-16-character-app-password
# Defaults to WARN_SMTP_USER if left blank.
WARN_ALERT_FROM=

# --- Website ---
# Used to build the links inside alert emails (unsubscribe, browse). Change
# this once the site is deployed somewhere other than your own machine.
WARN_SITE_URL=http://localhost:5000

# --- Database (optional) ---
# Defaults to a local SQLite file at data/warn.db. Point this at Postgres
# before deploying the site somewhere public.
# WARN_DB_URL=postgresql+psycopg://user:password@host/dbname
